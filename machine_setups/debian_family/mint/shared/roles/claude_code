#!/usr/bin/env bash
#
# Claude Code
#
# Based on https://code.claude.com/docs/en/setup#install-with-linux-package-managers
#
#author      :Tomas Skalicky <skalicky.tomas@gmail.com>
#===============================================================================

#-------------------------------------------------------------------------------

claude_code_prerequisity_packages_to_install=(
    curl
    gnupg
)

#-------------------------------------------------------------------------------

install_claude_code_prerequisity_packages() {
    aptget_install "${claude_code_prerequisity_packages_to_install[@]}"
}

#-------------------------------------------------------------------------------

# Release signing key of Claude Code
readonly claude_code_key_fingerprint=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE

verify_claude_code_apt_key() {
    local -r keyring_file_path=${1:?}
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    if ! gpg --show-keys --with-colons "$keyring_file_path" \
            | grep --quiet "^fpr:::::::::$claude_code_key_fingerprint:"
    then
        print_error "APT key $keyring_file_path does not have the expected fingerprint $claude_code_key_fingerprint."
        exit 1
    fi
}

#-------------------------------------------------------------------------------

configure_claude_code_apt_sources() {
    # "latest" serves every release; use "stable" for a version about a week old.
    local -r channel=latest
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    local -r keyring_file_name=claude-code.gpg
    local -r keyring_file_path=${keyrings_home:?}/$keyring_file_name
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    local file_contents
    set +e
    read -r -d '' file_contents <<- EOF
	# Generated by Tomas' setup scripts.
	deb   [signed-by=$keyring_file_path]   https://downloads.claude.ai/claude-code/apt/$channel   $channel   main
	EOF
    set -e
    set_file_contents \
                      /etc/apt/sources.list.d/claude-code.list \
                      "$file_contents"
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    aptkey_add https://downloads.claude.ai/keys/claude-code.asc "$keyring_file_name"
    verify_claude_code_apt_key "$keyring_file_path"
}

#-------------------------------------------------------------------------------

claude_code_packages_to_install=(
    claude-code
)

#-------------------------------------------------------------------------------

install_claude_code() {
    aptget_update
    aptget_install "${claude_code_packages_to_install[@]}"
}

#-------------------------------------------------------------------------------

main() {
    install_claude_code_prerequisity_packages
    configure_claude_code_apt_sources
    install_claude_code
}

#-------------------------------------------------------------------------------

main
