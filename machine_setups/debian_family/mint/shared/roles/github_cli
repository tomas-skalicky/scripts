#!/usr/bin/env bash
#
# GitHub CLI (gh) and GitHub access of Claude Code through the GitHub MCP server
#
# Based on
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md#debian
# https://github.com/github/github-mcp-server/blob/main/docs/installation-guides/install-claude.md
#
# The role does not contain any credentials. A personal access token for the
# GitHub MCP server is passed in by a machine-specific role, see
# configure_github_mcp_server_for_claude_code.
#
#author      :Tomas Skalicky <skalicky.tomas@gmail.com>
#===============================================================================

#-------------------------------------------------------------------------------

github_cli_prerequisity_packages_to_install=(
    wget
)

#-------------------------------------------------------------------------------

install_github_cli_prerequisity_packages() {
    aptget_install "${github_cli_prerequisity_packages_to_install[@]}"
}

#-------------------------------------------------------------------------------

configure_github_cli_apt_sources() {
    local -r keyring_file_path=${keyrings_home:?}/githubcli-archive-keyring.gpg
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    # The key is published already in the binary (dearmored) format.
    wget --quiet \
         --output-document="$keyring_file_path" \
         https://cli.github.com/packages/githubcli-archive-keyring.gpg
    chmod go+r "$keyring_file_path"
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    local architecture
    architecture=$(dpkg --print-architecture)
    local file_contents
    set +e
    read -r -d '' file_contents <<- EOF2
	# Generated by Tomas' setup scripts.
	deb   [arch=$architecture   signed-by=$keyring_file_path]   https://cli.github.com/packages   stable   main
	EOF2
    set -e
    set_file_contents \
                      /etc/apt/sources.list.d/github-cli.list \
                      "$file_contents"
}

#-------------------------------------------------------------------------------

github_cli_packages_to_install=(
    gh
)

#-------------------------------------------------------------------------------

install_github_cli() {
    aptget_update
    aptget_install "${github_cli_packages_to_install[@]}"
}

#-------------------------------------------------------------------------------

# Registers the remote GitHub MCP server in the user scope of Claude Code, so
# that Claude Code can work with issues, pull requests, etc. through MCP tools.
#
# $1: personal access token of GitHub. It is handed over to Claude Code through
#     an environment variable, not through a command line argument, to not to be
#     visible in the list of processes.
configure_github_mcp_server_for_claude_code() {
    local -r github_token=${1:?}
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    printf 'Registering the GitHub MCP server in Claude Code...'
    # Makes the registration idempotent.
    sudo --user="${username:?}" claude mcp remove github --scope user \
        > /dev/null 2>&1 || true
    GITHUB_MCP_TOKEN=$github_token \
        sudo --user="${username:?}" --preserve-env=GITHUB_MCP_TOKEN \
            bash -c '
                claude mcp add github \
                    --scope user \
                    --transport http \
                    https://api.githubcopilot.com/mcp/ \
                    --header "Authorization: Bearer $GITHUB_MCP_TOKEN"
            ' \
        > /dev/null
    printf ' %s.\n\n' 'done'
}

#-------------------------------------------------------------------------------

main() {
    install_github_cli_prerequisity_packages
    configure_github_cli_apt_sources
    install_github_cli
}

#-------------------------------------------------------------------------------

main
