#!/usr/bin/env bash
#
# Claude Desktop
#
# Installs the official Claude Desktop (beta) and makes sure it appears in the
# application menu.
#
#author      :Tomas Skalicky <skalicky.tomas@gmail.com>
#===============================================================================

#-------------------------------------------------------------------------------

claude_desktop_prerequisity_packages_to_install=(
    ca-certificates
    desktop-file-utils   # For validation of the .desktop file
    gnupg
    wget
    xdg-utils            # For refreshing of the application menu
)

#-------------------------------------------------------------------------------

install_claude_desktop_prerequisity_packages() {
    aptget_install "${claude_desktop_prerequisity_packages_to_install[@]}"
}

#-------------------------------------------------------------------------------

configure_claude_desktop_apt_sources() {
    local -r keyring_file_name=claude-desktop.gpg
    local -r keyring_file_path=${keyrings_home:?}/$keyring_file_name
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    local file_contents
    set +e
    read -r -d '' file_contents <<- EOF2
	# Generated by Tomas' setup scripts.
	deb   [arch=amd64,arm64 signed-by=$keyring_file_path]   https://downloads.claude.ai/claude-desktop/apt/stable   stable   main
	EOF2
    set -e
    set_file_contents \
                      /etc/apt/sources.list.d/claude-desktop.list \
                      "$file_contents"
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    aptkey_add https://downloads.claude.ai/claude-desktop/key.asc "$keyring_file_name"
}

#-------------------------------------------------------------------------------

claude_desktop_packages_to_install=(
    claude-desktop
)

#-------------------------------------------------------------------------------

install_claude_desktop() {
    aptget_update
    aptget_install "${claude_desktop_packages_to_install[@]}"
}

#-------------------------------------------------------------------------------

# Creates a menu entry only if the package does not ship any.
ensure_claude_desktop_menu_entry() {
    local -r fallback_desktop_file_path=/usr/share/applications/claude-desktop.desktop
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    local desktop_file_path
    desktop_file_path=$(dpkg -L claude-desktop | grep -E '/applications/.*\.desktop$' | head -n1 || true)
    if [[ -n $desktop_file_path && -f $desktop_file_path ]]; then
        print_info "Package provides menu entry: $desktop_file_path"
    else
        print_warning 'No .desktop file shipped by the package -> creating one.'
        local file_contents
        set +e
        read -r -d '' file_contents <<- EOF2
	[Desktop Entry]
	Type=Application
	Name=Claude
	GenericName=AI Assistant
	Comment=Claude Desktop by Anthropic
	Exec=claude-desktop %U
	Icon=claude-desktop
	Terminal=false
	Categories=Network;Office;Utility;Development;
	Keywords=AI;Claude;Anthropic;Chat;Assistant;
	StartupNotify=true
	StartupWMClass=Claude
	MimeType=x-scheme-handler/claude;
	EOF2
        set -e
        set_file_contents \
                          "$fallback_desktop_file_path" \
                          "$file_contents"
        desktop_file_path=$fallback_desktop_file_path
    fi
    desktop-file-validate "$desktop_file_path" \
        || print_warning 'desktop-file-validate reported issues (usually harmless).'
}

#-------------------------------------------------------------------------------

refresh_application_menu_and_icon_caches() {
    update-desktop-database -q /usr/share/applications || true
    if command -v gtk-update-icon-cache >/dev/null; then
        gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
    fi
    xdg-desktop-menu forceupdate --mode system 2>/dev/null || true
}

#-------------------------------------------------------------------------------

main() {
    install_claude_desktop_prerequisity_packages
    configure_claude_desktop_apt_sources
    install_claude_desktop
    ensure_claude_desktop_menu_entry
    refresh_application_menu_and_icon_caches
}

#-------------------------------------------------------------------------------

main
